<Window x:Class="TRPOLARIS.NFSU2.WebControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TRPOLARIS Control Center v1.7.1"
        Icon="{StaticResource AppIconDrawing}"
        Width="1420" Height="900" MinWidth="1080" MinHeight="700"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="14"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource AppBackground}" BorderBrush="#29445D"
            BorderThickness="1" CornerRadius="14" ClipToBounds="True">
        <Grid Background="{StaticResource AppBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Native-feeling custom title bar -->
            <Border x:Name="WindowTitleBar" Grid.Row="0" Background="#0A1625"
                    BorderBrush="#20364B" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="WindowTitleBar_MouseLeftButtonDown">
                <Grid Margin="17,0,7,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Image Source="{StaticResource AppIconDrawing}" Width="21" Height="21" Stretch="Uniform" Margin="0,0,10,0" />
                        <TextBlock Text="TRPOLARIS" FontSize="10" FontWeight="Bold" Foreground="#EAF5FF" VerticalAlignment="Center" />
                        <TextBlock Text="  /  INFRASTRUCTURE CONTROL" FontSize="9" FontWeight="SemiBold" Foreground="#8299B0" VerticalAlignment="Center" />
                        <Border Background="#123D45" BorderBrush="#286D70" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="11,0,0,0">
                            <TextBlock Text="v1.7.1" FontSize="9" FontWeight="Bold" Foreground="#6FF5E3" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MinimizeWindowButton" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource WindowCaptionButton}" Click="MinimizeWindow_Click"
                                ToolTip="Simge durumuna küçült" AutomationProperties.Name="Simge durumuna küçült">
                            <Path Data="M2,7 L10,7" Width="12" Height="12" Stretch="None" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.4" />
                        </Button>
                        <Button x:Name="MaximizeWindowButton" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource WindowCaptionButton}" Click="MaximizeWindow_Click"
                                ToolTip="Büyüt / geri yükle" AutomationProperties.Name="Büyüt veya geri yükle">
                            <Path x:Name="MaximizeWindowGlyph" Data="M2,2 H10 V10 H2 Z" Width="12" Height="12" Stretch="None" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.2" Fill="Transparent" />
                        </Button>
                        <Button x:Name="CloseWindowButton" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource WindowCloseButton}" Click="CloseWindow_Click"
                                ToolTip="Kapat" AutomationProperties.Name="Kapat">
                            <Path Data="M2,2 L10,10 M10,2 L2,10" Width="12" Height="12" Stretch="None" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.4" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="248" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Infrastructure tools. File manager and access/share remain available as requested. -->
                <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                        BorderBrush="#20364B" BorderThickness="0,0,1,0">
                    <Grid Margin="15,18,14,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,27">
                            <Grid Height="54">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="39" Height="39" CornerRadius="11" Background="#102B3C"
                                        BorderBrush="#28616A" BorderThickness="1" VerticalAlignment="Center">
                                    <Image Source="{StaticResource AppIconDrawing}" Width="31" Height="31" Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="TRPOLARIS" FontSize="16" FontWeight="Bold" Foreground="#F1F7FF" />
                                    <TextBlock Text="CONTROL CENTER" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="DEPLOYMENT CONSOLE" Style="{StaticResource Eyebrow}" Margin="2,16,0,0" />
                            <TextBlock Text="Kurulum ve altyapı" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="2,5,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="ÇALIŞMA ALANI" Style="{StaticResource Eyebrow}"
                                   Foreground="#718CA6" Margin="2,0,0,9" />

                        <StackPanel Grid.Row="2">
                            <Button x:Name="NavDashboard" Tag="Dashboard" Click="Navigation_Click" Style="{StaticResource NavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="29" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center" />
                                    <TextBlock Text="Genel Bakış" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavInstall" Tag="Install" Click="Navigation_Click" Style="{StaticResource NavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="29" VerticalAlignment="Center" />
                                    <TextBlock Text="Sunucu kurulumu" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavUpdate" Tag="Update" Click="Navigation_Click" Style="{StaticResource NavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="29" VerticalAlignment="Center" />
                                    <TextBlock Text="Altyapı güncelleme" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavFiles" Tag="Files" Click="Navigation_Click" Style="{StaticResource NavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="29" VerticalAlignment="Center" />
                                    <TextBlock Text="Dosya Yöneticisi" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavAccess" Tag="Access" Click="Navigation_Click" Style="{StaticResource NavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="29" VerticalAlignment="Center" />
                                    <TextBlock Text="Erişim ve Paylaşım" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavUninstall" Tag="Uninstall" Click="Navigation_Click" Style="{StaticResource NavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="29" VerticalAlignment="Center" />
                                    <TextBlock Text="Sunucuyu kaldır" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavLogs" Tag="Logs" Click="Navigation_Click" Style="{StaticResource NavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="29" VerticalAlignment="Center" />
                                    <TextBlock Text="İşlem günlükleri" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Margin="0,14,0,0">
                            <Border Height="1" Background="#21384D" Margin="0,0,0,13" />
                            <Border Background="#0D2030" BorderBrush="#254359" BorderThickness="1" CornerRadius="10" Padding="11">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="WslIndicator" Width="8" Height="8" Fill="{StaticResource WarningBrush}" Margin="0,0,9,0" />
                                        <TextBlock x:Name="WslSidebarText" Text="WSL DURUMU DENETLENİYOR" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="Windows host  /  WSL 2" FontSize="9" Foreground="#7F97AD" Margin="17,7,0,0" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text=".NET 10  ·  WPF  ·  x64" FontSize="9" Foreground="#607990" Margin="2,11,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Workspace -->
                <Grid Grid.Column="1" Background="{StaticResource AppBackground}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="76" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="32" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#0B1929" BorderBrush="#20384F" BorderThickness="0,0,0,1">
                        <Grid Margin="25,0,23,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TopEyebrow" Text="DEPLOYMENT / OVERVIEW" Style="{StaticResource Eyebrow}" Foreground="#7896B2" />
                                <TextBlock x:Name="TopTitle" Text="Altyapı kontrol merkezi" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#102A35" BorderBrush="#28616A" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,9,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="WslTopDot" Width="7" Height="7" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock x:Name="WslTopText" Text="WSL DENETLENİYOR" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                </Border>
                                <Button Click="CheckAppUpdates_Click" ToolTip="Control Center güncellemelerini denetle"
                                        Style="{StaticResource SecondaryButton}" Padding="11,8" MinHeight="36" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M4,14 L4,19 L20,19 L20,14 M12,3 L12,14 M7,9 L12,14 L17,9"
                                              Width="15" Height="15" Stretch="Uniform" Stroke="#9CC8FF" StrokeThickness="1.7"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,8,0" />
                                        <TextBlock Text="Uygulama güncellemesi" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="HeaderRefreshButton" Click="RefreshStatus_Click" ToolTip="WSL, Ubuntu ve Docker durumunu yenile"
                                        Style="{StaticResource SecondaryButton}" Height="36" MinHeight="36" Padding="10,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M3,8 C4,4 7,2 11,2 C15,2 18,4 19,7 M19,7 L19,3 M19,7 L15,7 M21,14 C20,18 17,20 13,20 C9,20 6,18 5,15 M5,15 L5,19 M5,15 L9,15"
                                              Width="15" Height="15" Stretch="Uniform" Stroke="#9CC8FF" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,7,0" />
                                        <TextBlock Text="Durumu yenile" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ContentControl x:Name="PageHost" Grid.Row="1" Margin="23,21,23,18" />

                    <Border x:Name="OperationProgressPanel" Grid.Row="2" Visibility="Collapsed"
                            Background="#0D1E2E" BorderBrush="#2B5267" BorderThickness="0,1,0,1" Padding="22,9">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="7" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="OperationProgressErrorCode" Visibility="Collapsed" FontSize="9" FontWeight="Bold" Margin="0,0,14,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="OperationProgressPercent" Text="~0%" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="OperationProgressStatus" Text="HAZIR" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="OperationProgressLabel" Text="İşlem bekleniyor" FontSize="10" Foreground="#B6C7D8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                            <ProgressBar x:Name="OperationProgressBar" Grid.Row="1" Minimum="0" Maximum="100" Value="0" Height="6" />
                            <TextBlock x:Name="OperationProgressHint" Grid.Row="2" Text="İşlem durumu ve ilerleme ayrıntıları." FontSize="9" Foreground="#7891A8" Margin="0,6,0,0" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="3" Background="#091625" BorderBrush="#1D3449" BorderThickness="0,1,0,0" Padding="22,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="FooterStatus" Text="Altyapı durumu denetleniyor..." FontSize="9" Foreground="#7F96AD" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="TRPOLARIS  /  NIGHT CIRCUIT" FontSize="8" FontWeight="Bold" Foreground="#55728A" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
