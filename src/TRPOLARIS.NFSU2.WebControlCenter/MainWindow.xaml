<Window x:Class="TRPOLARIS.NFSU2.WebControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NFSU2 Server control"
        Icon="{StaticResource AppIconDrawing}"
        Width="1280" Height="820" MinWidth="1080" MinHeight="700"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="18"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource AppBackground}"
            BorderBrush="#303B48"
            BorderThickness="1"
            CornerRadius="18"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom window chrome -->
            <Border x:Name="WindowTitleBar"
                    Grid.Row="0"
                    Background="#0C1016"
                    BorderBrush="#222B36"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="WindowTitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Border Width="24" Height="24" CornerRadius="7"
                                Background="#24201E" BorderBrush="#75422C" BorderThickness="1">
                            <Image Source="{StaticResource AppIconDrawing}" Width="17" Height="17" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="TRPOLARIS"
                                   Margin="11,0,0,0"
                                   FontSize="10"
                                   FontWeight="ExtraBold"
                                   Foreground="#F4F6F8"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="  /  NFSU2 SERVER CONTROL"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="#8793A2"
                                   VerticalAlignment="Center" />
                        <Border Background="#312018"
                                BorderBrush="#76452D"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,3"
                                Margin="12,0,0,0">
                            <TextBlock x:Name="AppVersionText"
                                       Text=""
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="#FFC09A" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MinimizeWindowButton"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource WindowCaptionButton}"
                                Click="MinimizeWindow_Click"
                                ToolTip="Simge durumuna küçült"
                                AutomationProperties.Name="Simge durumuna küçült">
                            <Path Data="M2,7 L10,7" Width="12" Height="12" Stretch="None"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.5" />
                        </Button>
                        <Button x:Name="MaximizeWindowButton"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource WindowCaptionButton}"
                                Click="MaximizeWindow_Click"
                                ToolTip="Büyüt / geri yükle"
                                AutomationProperties.Name="Büyüt veya geri yükle">
                            <Path x:Name="MaximizeWindowGlyph"
                                  Data="M2,2 H10 V10 H2 Z"
                                  Width="12" Height="12" Stretch="None"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.3" Fill="Transparent" />
                        </Button>
                        <Button x:Name="CloseWindowButton"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource WindowCloseButton}"
                                Click="CloseWindow_Click"
                                ToolTip="Kapat"
                                AutomationProperties.Name="Kapat">
                            <Path Data="M2,2 L10,10 M10,2 L2,10" Width="12" Height="12" Stretch="None"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.5" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Navigation rail -->
                <Border Grid.Column="0"
                        Background="#10151D"
                        BorderBrush="#293440"
                        BorderThickness="0,0,1,0">
                    <Grid Margin="13,14,13,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <Grid Height="58">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44"
                                        CornerRadius="14"
                                        Background="#292019"
                                        BorderBrush="#7B492E"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Image Source="{StaticResource AppIconDrawing}" Width="32" Height="32" Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="NFSU2"
                                               FontSize="19"
                                               FontWeight="ExtraBold"
                                               Foreground="#F6F7F8" />
                                    <TextBlock Text="SERVER CONTROL"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="#F49A64"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                            <Border Background="#171E27"
                                    BorderBrush="#303B48"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="11,9"
                                    Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="ÇALIŞMA ALANI"
                                               FontSize="9"
                                               FontWeight="ExtraBold"
                                               Foreground="#8996A5" />
                                    <TextBlock Text="Sunucu operasyonları"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#F0F2F4"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="Windows  ·  WSL  ·  Linux VPS"
                                               FontSize="10"
                                               Foreground="#97A3B1"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="GENEL BAKIŞ"
                                           FontSize="9"
                                           FontWeight="ExtraBold"
                                           Foreground="#7F8B99"
                                           Margin="8,0,0,8" />
                                <Button x:Name="NavDashboard" Tag="Dashboard"
                                        Click="Navigation_Click" Style="{StaticResource NavButton}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="9" Background="#292019" VerticalAlignment="Center">
                                            <Path Data="M3,3 H10 V10 H3 Z M14,3 H21 V10 H14 Z M3,14 H10 V21 H3 Z M14,14 H21 V21 H14 Z"
                                                  Stroke="#FF9B62" StrokeThickness="1.7" Fill="Transparent" StrokeLineJoin="Round"
                                                  Width="19" Height="19" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Operasyon merkezi" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>

                                <TextBlock Text="YEREL SUNUCU"
                                           FontSize="9"
                                           FontWeight="ExtraBold"
                                           Foreground="#7F8B99"
                                           Margin="8,21,0,8" />
                                <Button x:Name="NavInstall" Tag="Install" Click="Navigation_Click" Style="{StaticResource NavButton}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="10" Background="#1B2930" VerticalAlignment="Center">
                                            <Path Data="M12,2 V22 M2,12 H22 M5,5 L19,19 M19,5 L5,19" Stroke="#5BD0C2" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Kurulum ve yapılandırma" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="NavUpdate" Tag="Update" Click="Navigation_Click" Style="{StaticResource NavButton}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="10" Background="#242033" VerticalAlignment="Center">
                                            <Path Data="M20,7 V3 L24,7 L20,11 M4,17 V21 L0,17 L4,13 M5,7 A8,8 0 0 1 19,5 M19,17 A8,8 0 0 1 5,19"
                                                  Stroke="#B8A4FF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"
                                                  Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Altyapı güncelleme" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="NavAccess" Tag="Access" Click="Navigation_Click" Style="{StaticResource NavButton}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="10" Background="#202B35" VerticalAlignment="Center">
                                            <Path Data="M12,3 A3,3 0 1 0 12,9 A3,3 0 1 0 12,3 M4,17 A3,3 0 1 0 4,23 A3,3 0 1 0 4,17 M20,17 A3,3 0 1 0 20,23 A3,3 0 1 0 20,17 M12,9 V14 M4,17 L12,14 L20,17"
                                                  Stroke="#70BEEA" StrokeThickness="1.5" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Ağ erişimi ve paylaşım" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="NavFiles" Tag="Files" Click="Navigation_Click" Style="{StaticResource NavButton}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="10" Background="#29251D" VerticalAlignment="Center">
                                            <Path Data="M3,6 H10 L12,9 H21 V20 H3 Z" Stroke="#F4C36F" StrokeThickness="1.6" Fill="Transparent" StrokeLineJoin="Round" Width="19" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Yerel dosyalar" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>

                                <TextBlock Text="UZAK SUNUCU"
                                           FontSize="9"
                                           FontWeight="ExtraBold"
                                           Foreground="#7F8B99"
                                           Margin="8,21,0,8" />
                                <Button x:Name="NavRemote" Tag="Remote" Click="Navigation_Click" Style="{StaticResource NavButton}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="10" Background="#1D2934" VerticalAlignment="Center">
                                            <Path Data="M5,5 H19 V19 H5 Z M8,9 L11,12 L8,15 M13,15 H16" Stroke="#75C7D6" StrokeThickness="1.6" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="SSH bağlantıları" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="NavRemoteDeploy" Tag="RemoteDeploy" Click="Navigation_Click" Style="{StaticResource NavButton}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="10" Background="#292019" VerticalAlignment="Center">
                                            <Path Data="M12,3 V15 M7,10 L12,15 L17,10 M4,19 H20" Stroke="#FF9B62" StrokeThickness="1.7" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Uzak dağıtım" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="NavRemoteFiles" Tag="RemoteFiles" Click="Navigation_Click" Style="{StaticResource NavButton}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="10" Background="#29251D" VerticalAlignment="Center">
                                            <Path Data="M3,6 H10 L12,9 H21 V20 H3 Z M7,13 H17" Stroke="#F4C36F" StrokeThickness="1.6" Fill="Transparent" StrokeLineJoin="Round" Width="19" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Uzak dosya yöneticisi" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>

                                <TextBlock Text="YÖNETİM VE KAYITLAR"
                                           FontSize="9"
                                           FontWeight="ExtraBold"
                                           Foreground="#7F8B99"
                                           Margin="8,21,0,8" />
                                <Button x:Name="NavUninstall" Tag="Uninstall" Click="Navigation_Click" Style="{StaticResource NavButton}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="10" Background="#302028" VerticalAlignment="Center">
                                            <Path Data="M4,7 H20 M9,7 V4 H15 V7 M7,7 L8,20 H16 L17,7 M10,10 V17 M14,10 V17" Stroke="#FF8295" StrokeThickness="1.5" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Kaldırma merkezi" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="NavLogs" Tag="Logs" Click="Navigation_Click" Style="{StaticResource NavButton}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="10" Background="#202B35" VerticalAlignment="Center">
                                            <Path Data="M5,3 H16 L20,7 V21 H5 Z M15,3 V8 H20 M8,12 H16 M8,16 H16" Stroke="#91A9C3" StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="İşlem günlükleri" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="2"
                                Background="#171E27"
                                BorderBrush="#303B48"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="13"
                                Margin="0,15,0,0">
                            <StackPanel>
                                <TextBlock Text="YEREL HOST"
                                           FontSize="9"
                                           FontWeight="ExtraBold"
                                           Foreground="#8593A2" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                                    <Ellipse x:Name="WslIndicator" Width="9" Height="9" Fill="{StaticResource WarningBrush}" Margin="0,0,9,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="WslSidebarText" Text="ORTAM DENETLENİYOR" FontSize="10" FontWeight="Bold" Foreground="#E8EDF2" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Windows · WSL 2 · Docker Desktop"
                                           FontSize="10"
                                           Foreground="#8996A5"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Main workspace -->
                <Grid Grid.Column="1" Background="#0D1219">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="82" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="30" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#121922"
                            BorderBrush="#293440"
                            BorderThickness="0,0,0,1"
                            Padding="20,11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TopEyebrow"
                                           Text="CONTROL ROOM  /  OVERVIEW"
                                           FontSize="9"
                                           FontWeight="ExtraBold"
                                           Foreground="#FF9B62" />
                                <TextBlock x:Name="TopTitle"
                                           Text="Operasyon merkezi"
                                           FontSize="21"
                                           FontWeight="Bold"
                                           Foreground="#F3F5F7"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#1B252F"
                                        BorderBrush="#364451"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12,9"
                                        Margin="0,0,9,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="WslTopDot" Width="8" Height="8" Fill="{StaticResource WarningBrush}" Margin="0,0,8,0" />
                                        <TextBlock x:Name="WslTopText" Text="WSL DENETLENİYOR" FontSize="9" FontWeight="Bold" Foreground="#D0D8E1" />
                                    </StackPanel>
                                </Border>
                                <Button Click="CheckAppUpdates_Click"
                                        ToolTip="Uygulama güncellemelerini denetle"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M12,3 V15 M7,10 L12,15 L17,10 M4,20 H20" Stroke="#E1E8EF" StrokeThickness="1.6" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Margin="0,0,9,0" />
                                        <TextBlock Text="Güncellemeleri denetle" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Click="UpdateSettings_Click"
                                        ToolTip="Güncelleme tercihlerini düzenle"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M4,6 H20 M4,12 H20 M4,18 H20 M9,4 V8 M15,10 V14 M11,16 V20" Stroke="#D8CFFF" StrokeThickness="1.6" Fill="Transparent" Width="16" Height="16" Margin="0,0,9,0" />
                                        <TextBlock Text="Ayarlar" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="HeaderRefreshButton"
                                        Click="RefreshStatus_Click"
                                        ToolTip="Yerel Windows, WSL, Ubuntu ve Docker durumunu yenile"
                                        Style="{StaticResource ModernButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 20,7 A 8,8 0 0 0 6,5 L 3,8 M 3,3 L 3,8 L 8,8 M 4,17 A 8,8 0 0 0 18,19 L 21,16 M 16,16 L 21,16 L 21,21"
                                              Stroke="#171A1E" StrokeThickness="1.8" Fill="Transparent"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"/>
                                        <TextBlock Text="Durumu yenile" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ContentControl x:Name="PageHost"
                                    Grid.Row="1"
                                    Margin="18,14,18,14" />

                    <Border x:Name="OperationProgressPanel"
                            Grid.Row="2"
                            Visibility="Collapsed"
                            Background="#1A222C"
                            BorderBrush="#3B4653"
                            BorderThickness="0,1,0,1"
                            Padding="18,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="7" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="OperationProgressErrorCode"
                                               Text=""
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="#F5C36A"
                                               Margin="0,0,13,0"
                                               Visibility="Collapsed" />
                                    <TextBlock x:Name="OperationProgressPercent"
                                               Text="0%"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#FF9B62" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="OperationProgressStatus"
                                               Text="İŞLEM ÇALIŞIYOR"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="#FF9B62" />
                                    <TextBlock x:Name="OperationProgressLabel"
                                               Text="İşlem bekleniyor"
                                               FontSize="11"
                                               Foreground="#E5EAF0"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <ProgressBar x:Name="OperationProgressBar"
                                         Grid.Row="1"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Height="6" />
                            <TextBlock x:Name="OperationProgressHint"
                                       Grid.Row="2"
                                       Text="İşlem durumu ve ilerleme ayrıntıları."
                                       FontSize="9"
                                       Foreground="#A5B0BE"
                                       Margin="0,7,0,0" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="3"
                            Background="#0C1016"
                            BorderBrush="#293440"
                            BorderThickness="0,1,0,0"
                            Padding="18,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="FooterStatus"
                                       Text="Yerel ortam denetleniyor..."
                                       FontSize="9"
                                       Foreground="#9CA8B6"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="5" Height="5" Fill="#FF914F" Margin="0,0,8,0"/>
                                <TextBlock Text="TRPOLARIS  /  NFSU2 CONTROL ROOM"
                                           FontSize="8"
                                           FontWeight="Bold"
                                           Foreground="#74808D"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>