<Window x:Class="TRPOLARIS.NFSU2.WebControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NFSU2 Server control"
        Icon="{StaticResource AppIconDrawing}"
        Width="1480" Height="920" MinWidth="1120" MinHeight="720"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="18"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource AppBackground}"
            BorderBrush="#3B4648" BorderThickness="1" CornerRadius="18" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Carbon Forge title bar -->
            <Border x:Name="WindowTitleBar" Grid.Row="0"
                    Background="#171D1F" BorderBrush="#343F41" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="WindowTitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <Border Width="22" Height="22" CornerRadius="6"
                                Background="#2B2522" BorderBrush="#6F4636" BorderThickness="1">
                            <Image Source="{StaticResource AppIconDrawing}" Width="17" Height="17" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="TRPOLARIS" Margin="10,0,0,0" FontSize="10"
                                   FontWeight="ExtraBold" Foreground="#F3F0E8" VerticalAlignment="Center" />
                        <TextBlock Text=" / " Margin="7,0" FontSize="10" Foreground="#65706E" VerticalAlignment="Center" />
                        <TextBlock Text="NFSU2 SERVER CONTROL" FontSize="9" FontWeight="Bold"
                                   Foreground="#A8B0AB" VerticalAlignment="Center" />
                        <Border Background="#30362A" BorderBrush="#636B3D" BorderThickness="1"
                                CornerRadius="5" Padding="7,2" Margin="11,0,0,0">
                            <TextBlock x:Name="AppVersionText" Text="" FontSize="9"
                                       FontWeight="Bold" Foreground="#DCE681" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MinimizeWindowButton" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource WindowCaptionButton}" Click="MinimizeWindow_Click"
                                ToolTip="Simge durumuna küçült" AutomationProperties.Name="Simge durumuna küçült">
                            <Path Data="M2,7 L10,7" Width="12" Height="12" Stretch="None"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.4" />
                        </Button>
                        <Button x:Name="MaximizeWindowButton" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource WindowCaptionButton}" Click="MaximizeWindow_Click"
                                ToolTip="Büyüt / geri yükle" AutomationProperties.Name="Büyüt veya geri yükle">
                            <Path x:Name="MaximizeWindowGlyph" Data="M2,2 H10 V10 H2 Z"
                                  Width="12" Height="12" Stretch="None"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.2" Fill="Transparent" />
                        </Button>
                        <Button x:Name="CloseWindowButton" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource WindowCloseButton}" Click="CloseWindow_Click"
                                ToolTip="Kapat" AutomationProperties.Name="Kapat">
                            <Path Data="M2,2 L10,10 M10,2 L2,10" Width="12" Height="12" Stretch="None"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.4" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="254" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Navigation rail -->
                <Border Grid.Column="0" Background="#181F21"
                        BorderBrush="#343F41" BorderThickness="0,0,1,0">
                    <Grid Margin="17,19,15,15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,28">
                            <Grid Height="58">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="47" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="12"
                                        Background="#2A2421" BorderBrush="#85513A" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Image Source="{StaticResource AppIconDrawing}" Width="32" Height="32" Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,0,0">
                                    <TextBlock Text="NFSU2" FontSize="18" FontWeight="ExtraBold"
                                               Foreground="#F3F0E8" />
                                    <TextBlock Text="SERVER CONTROL" FontSize="8" FontWeight="Bold"
                                               Foreground="#FF8968" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                            <Border Background="#272F30" CornerRadius="8" Padding="10,8"
                                    Margin="0,15,0,0">
                                <StackPanel>
                                    <TextBlock Text="CONTROL PLANE" FontSize="8" FontWeight="Bold"
                                               Foreground="#A8B0AB" />
                                    <TextBlock Text="Kurulum · erişim · operasyon" FontSize="10"
                                               Foreground="#D0D4CC" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="ÇALIŞMA ALANI" FontSize="8"
                                   FontWeight="ExtraBold" Foreground="#79837E"
                                   Margin="3,0,0,10" />

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Button x:Name="NavDashboard" Tag="Dashboard" Click="Navigation_Click" Style="{StaticResource NavButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Width="31" VerticalAlignment="Center" />
                                        <TextBlock Text="Genel bakış" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavInstall" Tag="Install" Click="Navigation_Click" Style="{StaticResource NavButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Width="31" VerticalAlignment="Center" />
                                        <TextBlock Text="Sunucu kurulumu" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavRemote" Tag="Remote" Click="Navigation_Click" Style="{StaticResource NavButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE839;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Width="31" VerticalAlignment="Center" />
                                        <TextBlock Text="Uzak sunucu" VerticalAlignment="Center" />
                                        <Border Background="#453027" CornerRadius="4" Padding="5,2" Margin="9,0,0,0">
                                            <TextBlock Text="SSH" FontSize="8" FontWeight="Bold" Foreground="#FF9B78" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavUpdate" Tag="Update" Click="Navigation_Click" Style="{StaticResource NavButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Width="31" VerticalAlignment="Center" />
                                        <TextBlock Text="Altyapı güncelleme" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <TextBlock Text="DOSYA VE AĞ" FontSize="8" FontWeight="ExtraBold"
                                           Foreground="#79837E" Margin="4,22,0,9" />
                                <Button x:Name="NavFiles" Tag="Files" Click="Navigation_Click" Style="{StaticResource NavButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Width="31" VerticalAlignment="Center" />
                                        <TextBlock Text="Dosya yöneticisi" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavAccess" Tag="Access" Click="Navigation_Click" Style="{StaticResource NavButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Width="31" VerticalAlignment="Center" />
                                        <TextBlock Text="Erişim ve paylaşım" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <TextBlock Text="SİSTEM" FontSize="8" FontWeight="ExtraBold"
                                           Foreground="#79837E" Margin="4,22,0,9" />
                                <Button x:Name="NavUninstall" Tag="Uninstall" Click="Navigation_Click" Style="{StaticResource NavButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Width="31" VerticalAlignment="Center" />
                                        <TextBlock Text="Kaldırma merkezi" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavLogs" Tag="Logs" Click="Navigation_Click" Style="{StaticResource NavButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Width="31" VerticalAlignment="Center" />
                                        <TextBlock Text="İşlem günlükleri" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="3" Margin="0,14,0,0">
                            <Border Height="1" Background="#343F41" Margin="0,0,0,13" />
                            <Border Background="#22292B" BorderBrush="#3B4648" BorderThickness="1"
                                    CornerRadius="10" Padding="11">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="WslIndicator" Width="8" Height="8"
                                                 Fill="{StaticResource WarningBrush}" Margin="0,0,9,0" />
                                        <TextBlock x:Name="WslSidebarText" Text="WSL DURUMU DENETLENİYOR"
                                                   FontSize="8" FontWeight="ExtraBold" Foreground="#A8B0AB" />
                                    </StackPanel>
                                    <TextBlock Text="Windows host  /  WSL 2" FontSize="9"
                                               Foreground="#79837E" Margin="17,7,0,0" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text=".NET 10  ·  WPF  ·  x64" FontSize="8"
                                       Foreground="#69736F" Margin="2,11,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main workspace -->
                <Grid Grid.Column="1" Background="#111719">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="82" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="32" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#171E20"
                            BorderBrush="#343F41" BorderThickness="0,0,0,1">
                        <Grid Margin="26,0,24,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TopEyebrow" Text="OVERVIEW / OPERATIONS"
                                           FontSize="8" FontWeight="ExtraBold" Foreground="#FF8968" />
                                <TextBlock x:Name="TopTitle" Text="Altyapı kontrol merkezi"
                                           FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"
                                           Foreground="#F3F0E8" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#242B2C" BorderBrush="#424B49" BorderThickness="1"
                                        CornerRadius="8" Padding="10,8" Margin="0,0,9,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="WslTopDot" Width="7" Height="7"
                                                 Fill="{StaticResource WarningBrush}" VerticalAlignment="Center"
                                                 Margin="0,0,8,0" />
                                        <TextBlock x:Name="WslTopText" Text="WSL DENETLENİYOR"
                                                   FontSize="8" FontWeight="Bold" Foreground="#B5BDB5" />
                                    </StackPanel>
                                </Border>
                                <Button Click="CheckAppUpdates_Click" ToolTip="Uygulama güncellemelerini denetle"
                                        Style="{StaticResource SecondaryButton}" Padding="11,8"
                                        MinHeight="36" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M4,14 L4,19 L20,19 L20,14 M12,3 L12,14 M7,9 L12,14 L17,9"
                                              Width="15" Height="15" Stretch="Uniform" Stroke="#D8DE73"
                                              StrokeThickness="1.7" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,8,0" />
                                        <TextBlock Text="Güncellemeler" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Click="UpdateSettings_Click" ToolTip="Güncelleme kanalı, kontrol sıklığı ve geçmiş"
                                        Style="{StaticResource SecondaryButton}" Padding="10,8" MinHeight="36"
                                        Margin="0,0,8,0">
                                    <Path Data="M12,8.2 A3.8,3.8 0 1 0 12,15.8 A3.8,3.8 0 1 0 12,8.2 M19.4,13.5 L21,14.7 L19.5,17.3 L17.9,16.5 A8,8 0 0 1 16.2,17.5 L16,19.4 L13,20 L12.3,18.2 A8,8 0 0 1 10.3,18.1 L9.2,19.6 L6.5,18.2 L7,16.4 A8,8 0 0 1 5.6,14.9 L3.7,15.2 L2.8,12.2 L4.5,11.2 A8,8 0 0 1 4.7,9.2 L3.2,8 L4.7,5.4 L6.5,6.1 A8,8 0 0 1 8.2,5.1 L8.4,3.2 L11.4,2.6 L12.1,4.4 A8,8 0 0 1 14.1,4.5 L15.2,3 L17.9,4.4 L17.4,6.2 A8,8 0 0 1 18.8,7.7 L20.7,7.4 L21.6,10.4 L19.9,11.4 A8,8 0 0 1 19.4,13.5 Z"
                                          Width="16" Height="16" Stretch="Uniform" Stroke="#D8DE73"
                                          StrokeThickness="1.1" Fill="Transparent" />
                                </Button>
                                <Button x:Name="HeaderRefreshButton" Click="RefreshStatus_Click"
                                        ToolTip="WSL, Ubuntu ve Docker durumunu yenile"
                                        Style="{StaticResource SecondaryButton}" Height="36" MinHeight="36"
                                        Padding="10,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M3,8 C4,4 7,2 11,2 C15,2 18,4 19,7 M19,7 L19,3 M19,7 L15,7 M21,14 C20,18 17,20 13,20 C9,20 6,18 5,15 M5,15 L5,19 M5,15 L9,15"
                                              Width="15" Height="15" Stretch="Uniform" Stroke="#D8DE73"
                                              StrokeThickness="1.6" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,7,0" />
                                        <TextBlock Text="Yenile" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ContentControl x:Name="PageHost" Grid.Row="1" Margin="24,22,24,18" />

                    <Border x:Name="OperationProgressPanel" Grid.Row="2" Visibility="Collapsed"
                            Background="#202729" BorderBrush="#485252" BorderThickness="0,1,0,1"
                            Padding="22,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="7" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,7">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="OperationProgressErrorCode" Text="" FontSize="9"
                                               Foreground="#EAB96A" VerticalAlignment="Center" />
                                    <TextBlock x:Name="OperationProgressPercent" Text="0%" FontSize="10"
                                               FontWeight="Bold" Foreground="#D8DE73"
                                               VerticalAlignment="Center" Margin="14,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Fill="#FF7043" Margin="0,0,9,0" />
                                    <TextBlock x:Name="OperationProgressStatus" Text="İŞLEM ÇALIŞIYOR"
                                               FontSize="8" FontWeight="ExtraBold" Foreground="#FF8968"
                                               Margin="0,0,10,0" />
                                    <TextBlock x:Name="OperationProgressLabel" Text="İşlem bekleniyor"
                                               FontSize="10" Foreground="#F3F0E8" />
                                </StackPanel>
                            </DockPanel>
                            <ProgressBar x:Name="OperationProgressBar" Grid.Row="1"
                                         Minimum="0" Maximum="100" Value="0" Height="6" />
                            <TextBlock x:Name="OperationProgressHint" Grid.Row="2"
                                       Text="İşlem durumu ve ilerleme ayrıntıları."
                                       FontSize="9" Foreground="#9DA7A0" Margin="0,7,0,0" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="3" Background="#171F21" BorderBrush="#343F41"
                            BorderThickness="0,1,0,0" Padding="22,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="FooterStatus" Text="Altyapı durumu denetleniyor..."
                                       FontSize="9" Foreground="#9DA7A0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="TRPOLARIS  /  CARBON FORGE"
                                       FontSize="8" FontWeight="Bold" Foreground="#69736F"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>