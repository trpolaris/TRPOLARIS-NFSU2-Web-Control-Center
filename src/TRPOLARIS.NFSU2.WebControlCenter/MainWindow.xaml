<Window x:Class="TRPOLARIS.NFSU2.WebControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NFSU2 Server control"
        Icon="{StaticResource AppIconDrawing}"
        Width="1380" Height="850" MinWidth="1080" MinHeight="690"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="16"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource AppBackground}"
            BorderBrush="#2B3C54"
            BorderThickness="1"
            CornerRadius="16"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Application chrome -->
            <Border x:Name="WindowTitleBar"
                    Grid.Row="0"
                    Background="#111C2D"
                    BorderBrush="#1E2D49"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="WindowTitleBar_MouseLeftButtonDown">
                <Grid Margin="13,0,7,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <Border Width="20" Height="20" CornerRadius="5"
                                Background="#1A2A47" BorderBrush="#35527D" BorderThickness="1">
                            <Image Source="{StaticResource AppIconDrawing}" Width="13" Height="13" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="TRPOLARIS"
                                   Margin="10,0,0,0"
                                   FontSize="10"
                                   FontWeight="ExtraBold"
                                   Foreground="#EAF1FF"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="  /  NFSU2 SERVER CONTROL"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="#7F91B0"
                                   VerticalAlignment="Center" />
                        <Border Background="#1B2C48"
                                BorderBrush="#38527A"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="7,2"
                                Margin="12,0,0,0">
                            <TextBlock x:Name="AppVersionText"
                                       Text=""
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="#AFCBFF" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MinimizeWindowButton"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource WindowCaptionButton}"
                                Click="MinimizeWindow_Click"
                                ToolTip="Simge durumuna küçült"
                                AutomationProperties.Name="Simge durumuna küçült">
                            <Path Data="M2,7 L10,7" Width="12" Height="12" Stretch="None"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.4" />
                        </Button>
                        <Button x:Name="MaximizeWindowButton"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource WindowCaptionButton}"
                                Click="MaximizeWindow_Click"
                                ToolTip="Büyüt / geri yükle"
                                AutomationProperties.Name="Büyüt veya geri yükle">
                            <Path x:Name="MaximizeWindowGlyph"
                                  Data="M2,2 H10 V10 H2 Z"
                                  Width="12" Height="12" Stretch="None"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.2" Fill="Transparent" />
                        </Button>
                        <Button x:Name="CloseWindowButton"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource WindowCloseButton}"
                                Click="CloseWindow_Click"
                                ToolTip="Kapat"
                                AutomationProperties.Name="Kapat">
                            <Path Data="M2,2 L10,10 M10,2 L2,10" Width="12" Height="12" Stretch="None"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.4" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left navigation -->
                <Border Grid.Column="0"
                        Background="#0D1527"
                        BorderBrush="#202F4B"
                        BorderThickness="0,0,1,0">
                    <Grid Margin="12,12,12,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <Grid Height="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36"
                                        CornerRadius="12"
                                        Background="#192B49"
                                        BorderBrush="#3A5C8A"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Image Source="{StaticResource AppIconDrawing}" Width="27" Height="27" Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                                    <TextBlock Text="NFSU2"
                                               FontSize="16"
                                               FontWeight="ExtraBold"
                                               Foreground="#F0F4FF" />
                                    <TextBlock Text="CONTROL CENTER"
                                               FontSize="8"
                                               FontWeight="ExtraBold"
                                               Foreground="#83AEF8"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                            <Border Background="#141F35"
                                    BorderBrush="#263958"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8,6"
                                    Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="WORKSPACE"
                                               FontSize="8"
                                               FontWeight="ExtraBold"
                                               Foreground="#8294B3" />
                                    <TextBlock Text="Sunucu operasyonları"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#DCE6FA"
                                               Margin="0,2,0,0" />
                                    <TextBlock Text="Windows  ·  WSL  ·  Linux VPS"
                                               FontSize="8"
                                               Foreground="#788AA9"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="GENEL"
                                           FontSize="8"
                                           FontWeight="ExtraBold"
                                           Foreground="#7385A5"
                                           Margin="4,0,0,5" />
                                <Button x:Name="NavDashboard" Tag="Dashboard"
                                        Click="Navigation_Click" Style="{StaticResource NavButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14" Width="24" VerticalAlignment="Center" />
                                        <TextBlock Text="Control room" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <TextBlock Text="YEREL ORTAM"
                                           FontSize="8"
                                           FontWeight="ExtraBold"
                                           Foreground="#7385A5"
                                           Margin="4,14,0,5" />
                                <Button x:Name="NavInstall" Tag="Install"
                                        Click="Navigation_Click" Style="{StaticResource NavButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16" Width="24" VerticalAlignment="Center" />
                                        <TextBlock Text="Yerel sunucu" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavUpdate" Tag="Update"
                                        Click="Navigation_Click" Style="{StaticResource NavButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14" Width="24" VerticalAlignment="Center" />
                                        <TextBlock Text="Altyapı güncelleme" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavAccess" Tag="Access"
                                        Click="Navigation_Click" Style="{StaticResource NavButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16" Width="26" VerticalAlignment="Center" />
                                        <TextBlock Text="Yerel ağ erişimi" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavFiles" Tag="Files"
                                        Click="Navigation_Click" Style="{StaticResource NavButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16" Width="26" VerticalAlignment="Center" />
                                        <TextBlock Text="Yerel dosyalar" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <TextBlock Text="UZAK SUNUCULAR"
                                           FontSize="8"
                                           FontWeight="ExtraBold"
                                           Foreground="#7385A5"
                                           Margin="4,14,0,5" />
                                <Button x:Name="NavRemote" Tag="Remote"
                                        Click="Navigation_Click" Style="{StaticResource NavButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE839;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16" Width="26" VerticalAlignment="Center" />
                                        <TextBlock Text="SSH bağlantıları" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavRemoteDeploy" Tag="RemoteDeploy"
                                        Click="Navigation_Click" Style="{StaticResource NavButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16" Width="26" VerticalAlignment="Center" />
                                        <TextBlock Text="Uzak dağıtım" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavRemoteFiles" Tag="RemoteFiles"
                                        Click="Navigation_Click" Style="{StaticResource NavButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16" Width="26" VerticalAlignment="Center" />
                                        <TextBlock Text="Uzak dosyalar" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <TextBlock Text="YÖNETİM"
                                           FontSize="8"
                                           FontWeight="ExtraBold"
                                           Foreground="#7385A5"
                                           Margin="4,14,0,5" />
                                <Button x:Name="NavUninstall" Tag="Uninstall"
                                        Click="Navigation_Click" Style="{StaticResource NavButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16" Width="26" VerticalAlignment="Center" />
                                        <TextBlock Text="Kaldırma merkezi" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavLogs" Tag="Logs"
                                        Click="Navigation_Click" Style="{StaticResource NavButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16" Width="26" VerticalAlignment="Center" />
                                        <TextBlock Text="İşlem günlükleri" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                            <Border Height="1" Background="#263653" Margin="0,0,0,9" />
                            <Border Background="#141F35"
                                    BorderBrush="#263958"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="WslIndicator"
                                                 Width="8" Height="8"
                                                 Fill="{StaticResource WarningBrush}"
                                                 Margin="0,0,9,0" />
                                        <TextBlock x:Name="WslSidebarText"
                                                   Text="ORTAM DENETLENİYOR"
                                                   FontSize="8"
                                                   FontWeight="ExtraBold"
                                                   Foreground="#AAB9D3" />
                                    </StackPanel>
                                    <TextBlock Text="Yerel Windows host"
                                               FontSize="9"
                                               Foreground="#7D8FAE"
                                               Margin="15,5,0,0" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text=".NET 10  ·  WPF  ·  x64"
                                       FontSize="8"
                                       Foreground="#657795"
                                       Margin="2,7,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main workspace -->
                <Grid Grid.Column="1" Background="#0E1625">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="28" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#101A2B"
                            BorderBrush="#2B3C54"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="20,0,18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TopEyebrow"
                                           Text="CONTROL ROOM / OVERVIEW"
                                           FontSize="8"
                                           FontWeight="ExtraBold"
                                           Foreground="#80AAEF" />
                                <TextBlock x:Name="TopTitle"
                                           Text="Operasyon merkezi"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           Foreground="#EDF3FF"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Border Background="#15223A"
                                        BorderBrush="#2C4267"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="8,6"
                                        Margin="0,0,7,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="WslTopDot"
                                                 Width="7" Height="7"
                                                 Fill="{StaticResource WarningBrush}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0" />
                                        <TextBlock x:Name="WslTopText"
                                                   Text="WSL DENETLENİYOR"
                                                   FontSize="8"
                                                   FontWeight="Bold"
                                                   Foreground="#B9C7E0" />
                                    </StackPanel>
                                </Border>
                                <Button Click="CheckAppUpdates_Click"
                                        ToolTip="Uygulama güncellemelerini denetle"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="11,8"
                                        MinHeight="32"
                                        Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M4,14 L4,19 L20,19 L20,14 M12,3 L12,14 M7,9 L12,14 L17,9"
                                              Width="13" Height="13" Stretch="Uniform"
                                              Stroke="#AFCBFF" StrokeThickness="1.7"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" Margin="0,0,8,0" />
                                        <TextBlock Text="Güncellemeler" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Click="UpdateSettings_Click"
                                        ToolTip="Güncelleme kanalı, kontrol sıklığı ve geçmiş"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="8,6"
                                        MinHeight="32"
                                        Margin="0,0,8,0">
                                    <Path Data="M12,8.2 A3.8,3.8 0 1 0 12,15.8 A3.8,3.8 0 1 0 12,8.2 M19.4,13.5 L21,14.7 L19.5,17.3 L17.9,16.5 A8,8 0 0 1 16.2,17.5 L16,19.4 L13,20 L12.3,18.2 A8,8 0 0 1 10.3,18.1 L9.2,19.6 L6.5,18.2 L7,16.4 A8,8 0 0 1 5.6,14.9 L3.7,15.2 L2.8,12.2 L4.5,11.2 A8,8 0 0 1 4.7,9.2 L3.2,8 L4.7,5.4 L6.5,6.1 A8,8 0 0 1 8.2,5.1 L8.4,3.2 L11.4,2.6 L12.1,4.4 A8,8 0 0 1 14.1,4.5 L15.2,3 L17.9,4.4 L17.4,6.2 A8,8 0 0 1 18.8,7.7 L20.7,7.4 L21.6,10.4 L19.9,11.4 A8,8 0 0 1 19.4,13.5 Z"
                                          Width="13" Height="13" Stretch="Uniform"
                                          Stroke="#AFCBFF" StrokeThickness="1.1" Fill="Transparent" />
                                </Button>
                                <Button x:Name="HeaderRefreshButton"
                                        Click="RefreshStatus_Click"
                                        ToolTip="Yerel Windows, WSL, Ubuntu ve Docker durumunu yenile"
                                        Style="{StaticResource SecondaryButton}"
                                        Height="32"
                                        MinHeight="32"
                                        Padding="8,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M3,8 C4,4 7,2 11,2 C15,2 18,4 19,7 M19,7 L19,3 M19,7 L15,7 M21,14 C20,18 17,20 13,20 C9,20 6,18 5,15 M5,15 L5,19 M5,15 L9,15"
                                              Width="15" Height="15" Stretch="Uniform"
                                              Stroke="#AFCBFF" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" Margin="0,0,7,0" />
                                        <TextBlock Text="Yenile" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ContentControl x:Name="PageHost"
                                    Grid.Row="1"
                                    Margin="16,12,16,12" />

                    <Border x:Name="OperationProgressPanel"
                            Grid.Row="2"
                            Visibility="Collapsed"
                            Background="#111D32"
                            BorderBrush="#2B4063"
                            BorderThickness="0,1,0,1"
                            Padding="16,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="7" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,5">
                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="OperationProgressErrorCode"
                                               Text=""
                                               FontSize="9"
                                               Foreground="#F6C66B"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="OperationProgressPercent"
                                               Text="0%"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="#8FB6FF"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Fill="#70A5FF" Margin="0,0,9,0" />
                                    <TextBlock x:Name="OperationProgressStatus"
                                               Text="İŞLEM ÇALIŞIYOR"
                                               FontSize="8"
                                               FontWeight="ExtraBold"
                                               Foreground="#86B0FF"
                                               Margin="0,0,10,0" />
                                    <TextBlock x:Name="OperationProgressLabel"
                                               Text="İşlem bekleniyor"
                                               FontSize="10"
                                               Foreground="#EDF3FF" />
                                </StackPanel>
                            </DockPanel>
                            <ProgressBar x:Name="OperationProgressBar"
                                         Grid.Row="1"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Height="6" />
                            <TextBlock x:Name="OperationProgressHint"
                                       Grid.Row="2"
                                       Text="İşlem durumu ve ilerleme ayrıntıları."
                                       FontSize="9"
                                       Foreground="#91A3BE"
                                       Margin="0,7,0,0" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="3"
                            Background="#0D1527"
                            BorderBrush="#202F4A"
                            BorderThickness="0,1,0,0"
                            Padding="18,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="FooterStatus"
                                       Text="Yerel ortam denetleniyor..."
                                       FontSize="9"
                                       Foreground="#91A3BE"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="TRPOLARIS  /  NFSU2 CONTROL ROOM"
                                       FontSize="8"
                                       FontWeight="Bold"
                                       Foreground="#617493"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>