<Window x:Class="TRPOLARIS.NFSU2.WebControlCenter.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NFSU2 Server control"
        Width="620" Height="390" ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Topmost="True">
    <Grid Background="Transparent" MouseLeftButtonDown="SplashSurface_MouseLeftButtonDown">
        <Border CornerRadius="22" Background="#081523" BorderBrush="#2A5269" BorderThickness="1"
                Padding="30" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#02060D" BlurRadius="34" ShadowDepth="9" Opacity="0.62" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Animated ambient glow -->
                <Ellipse Width="245" Height="245" HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,-135,-105,0" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#5E3E95A8" Offset="0" />
                            <GradientStop Color="#183A91A0" Offset="0.47" />
                            <GradientStop Color="#003A91A0" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.45" To="0.95" Duration="0:0:2.8" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="43" Height="43" CornerRadius="13" Background="#102D40"
                            BorderBrush="#32717B" BorderThickness="1" VerticalAlignment="Center">
                        <Image Source="{StaticResource AppIconDrawing}" Width="34" Height="34" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="NFSU2 Server control" FontSize="15" FontWeight="Bold" Foreground="#F1F7FF" />
                        <TextBlock Text="SERVER INFRASTRUCTURE" FontSize="9" FontWeight="Bold" Foreground="#58DCCD" Margin="0,3,0,0" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="#102D40" BorderBrush="#27566D" BorderThickness="1"
                            CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                        <TextBlock x:Name="SplashVersionText" Text="" FontSize="9" FontWeight="Bold" Foreground="#85B9FF" />
                    </Border>
                </Grid>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,18,0,18">
                    <TextBlock Text="SYSTEM STARTUP" FontSize="9" FontWeight="Bold" Foreground="#6D92B1" Margin="0,0,0,3" />
                    <TextBlock Text="Altyapı hazırlanıyor" FontSize="25" FontWeight="SemiBold" Foreground="#F0F6FD" Margin="0,5,0,0" TextWrapping="Wrap" MaxWidth="540" />
                    <TextBlock x:Name="SplashStatus" Text="Güncellemeler denetleniyor..." FontSize="12" FontWeight="SemiBold" Foreground="#78EADB" Margin="0,9,0,0" TextWrapping="Wrap" MaxWidth="540" />
                    <TextBlock x:Name="SplashDetail" Text="GitHub Release bilgileri kontrol ediliyor." FontSize="10" Foreground="#91A6BC" Margin="0,5,0,0" TextWrapping="Wrap" MaxWidth="540" MinHeight="24" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="BAŞLATMA İLERLEMESİ" FontSize="8" FontWeight="Bold" Foreground="#7893AA" VerticalAlignment="Center" />
                        <TextBlock x:Name="SplashPercent" Grid.Column="1" Text="0%" FontSize="11" FontWeight="Bold" Foreground="#60E7D5" />
                    </Grid>
                    <ProgressBar x:Name="SplashProgress" Minimum="0" Maximum="100" Value="0" Height="7"
                                 Background="#1A3044" Foreground="#43E4D0" BorderThickness="0" />
                    <Grid Margin="0,13,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="GitHub  ·  WSL 2  ·  Docker" FontSize="9" Foreground="#607A93" />
                        <TextBlock Grid.Column="1" Text="NIGHT CIRCUIT" FontSize="8" FontWeight="Bold" Foreground="#55758D" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
